{
  "name": "microbrain-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "menu": "node createMenu.mjs",
    "test:agent": "node --test test/agent-*.test.mjs",
    "lint:boundaries": "node test/agent-boundaries.mjs",
    "format:agent": "prettier --config pages/agent/.prettierrc.json --write \"pages/agent/**/*.{vue,js,mjs,scss,css}\" \"!pages/agent/prototypes/**\" \"apis/agent/**/*.{js,mjs}\"",
    "format:agent:check": "prettier --config pages/agent/.prettierrc.json --check \"pages/agent/**/*.{vue,js,mjs,scss,css}\" \"!pages/agent/prototypes/**\" \"apis/agent/**/*.{js,mjs}\""
  },
  "dependencies": {
    "crypto-js": "^4.1.1",
    "dayjs": "^1.11.4",
    "flyio": "^0.6.14"
  },
  "devDependencies": {
    "chalk": "^5.0.1",
    "fs": "^0.0.1-security",
    "prettier": "3.6.2"
  }
}
